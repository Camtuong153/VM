r1='\033[0;31m'
r2='\033[0;32m'
r3='\033[0;33m'
r4='\033[0;34m'
r0='\033[0m' # Mã reset màu về mặc định

clear
echo -e "${r1}========================================================${r0}"
echo -e "${r2}[hello world!!,thank you for install pack!]${r0}"
echo -e "${r1}========================================================${r0}"
echo -e "${r2}remove[file/app/apk]-press>('./uninstall.sh')${r0}"
mkdir -p ~/info
cat << EOF > uninstall.sh
cat << EOF > ~/.Bashrc
clear
echo "startup done!"
EOF
rm -rf ~/info
rm -- "$0"
EOF
chmod +x uninstall.sh
cat << EOF > ~/info/info.txt
hello user
This is the code for you. 
This code is used to download Ubuntu XFCE. 
wire code: curl -O https://raw.githubusercontent.com/Camtuong153/VM/refs/heads/main/ubuntu_install.sh ; chmod +x ubuntu_install.sh
code is beta -1
EOF
cat << EOF > ~/.bashrc
r1='\033[0;31m'
r2='\033[0;32m'
r3='\033[0;33m'
r4='\033[0;34m'
r0='\033[0m'

clear
echo -e "${r3}modpack auto update runing..${r0}"
sleep 2
pkg update ; pkg upgrade -y
apt update ; apt upgrade -y
yes | termux-setup-storage
echo -e "${r2}done!${r0}"
EOF
rm -- "$0"
exit 1