r1='\033[0;31m'
r2='\033[0;32m'
r3='\033[0;33m'
r4='\033[0;34m'
r0='\033[0m' # Mã reset màu về mặc định

clear
echo -e "${r1}========================================================${r0}"
echo -e "${r2}[hello world!!,thank you for install pack!]${r0}"
echo -e "${r1}========================================================${r0}"
echo -e "${r2}remove[file/app/apk]-press>('./uninstall.sh')${r0}"
echo -e "${r2} to install windowsxp vm user press ('cd info ; cat info.txt')${r0}"
mkdir -p ~/info
curl -o uninstall.sh "https://raw.githubusercontent.com/Camtuong153/VM/refs/heads/main/unstall.sh" ; chmod +x uninstall.sh
cat << EOF > ~/info/info.txt
hello user
This is the code for you. 
This code is used to download windowsXP
wire code: wget -O setupxp.sh https://raw.githubusercontent.com/Camtuong153/VM/refs/heads/main/ubuntu_install.sh ; chmod +x setupxp.sh
code is beta -1
EOF
cat << EOF > ~/.bashrc
r1='\033[0;31m'
r2='\033[0;32m'
r3='\033[0;33m'
r4='\033[0;34m'
r0='\033[0m'

clear
echo -e "${r3}modpack auto update runing..${r0}"
sleep 2
pkg update ; pkg upgrade -y
apt update ; apt upgrade -y
yes | termux-setup-storage
echo -e "${r2}done!${r0}"
EOF
rm -- "$0"
termux-open-url "https://camtuong.github.io"
echo -e "${r2}shutdown-termuxing...${r0}"
sleep 20
clear
#Killing Termux will help the system run more smoothly when redirecting users! 
pkill termux
